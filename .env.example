# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---- LLM Configuration ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MODEL_NAME=gpt-4o-mini
# DEFAULT_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.2

# ---- Embedding Configuration ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
# Local Qdrant:
QDRANT_URL=http://localhost:6333
# Qdrant Cloud example:
# QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ai_documents

# ---- Object Storage (Cloudflare R2 — lưu tài liệu gốc) ----
# OBJECT_STORAGE_PROVIDER=local  -> chỉ lưu file local (mặc định, không cần R2)
# OBJECT_STORAGE_PROVIDER=r2     -> bật upload bản gốc lên Cloudflare R2
OBJECT_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto

# ---- Message Queue (Redis + arq — xử lý tài liệu nền) ----
REDIS_URL=redis://localhost:6379/0
# INGEST_ASYNC=true  -> upload đẩy job vào hàng đợi (CẦN chạy worker: python -m src.worker)
# INGEST_ASYNC=false -> xử lý ngay trong request (mặc định)
INGEST_ASYNC=false

# SEED_DEMO=true -> tự tạo tài khoản demo (admin/lecturer/student) khi khởi động.
# Tiện cho deploy không có Shell. Bật cho lần deploy đầu rồi có thể tắt.
SEED_DEMO=false

# USE_DOCLING=true  -> dùng docling (chất lượng cao nhưng nặng RAM, cần >=2GB)
# USE_DOCLING=false -> trích xuất nhẹ pypdf/docx/pptx (tránh OOM trên instance nhỏ)
USE_DOCLING=true

# Proxy lấy transcript YouTube khi chạy trên cloud (Render hay bị YouTube chặn IP).
# Định dạng: http://user:pass@host:port  — để TRỐNG nếu chạy ở máy IP dân dụng.
YOUTUBE_PROXY_URL=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth (JWT) ----
# BẮT BUỘC đổi trong production. Sinh chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me

# ---- Đăng nhập bằng Gmail (Google OAuth) ----
# Tạo OAuth Client ID (Web) tại https://console.cloud.google.com → APIs & Services → Credentials.
# Backend dùng để xác minh ID token; Frontend dùng (VITE_GOOGLE_CLIENT_ID) để render nút Google.
# DÙNG CÙNG MỘT giá trị cho cả hai.
GOOGLE_CLIENT_ID=

# ---- Email ----
# KHUYẾN NGHỊ DEPLOY (Render): dùng Brevo HTTP API vì Render CHẶN cổng SMTP
# 25/465/587. Có BREVO_API_KEY thì hệ thống ưu tiên gửi qua Brevo (cổng 443).
# Tạo key: https://app.brevo.com/settings/keys/api — và verify sender = EMAIL_FROM.
BREVO_API_KEY=
EMAIL_FROM=dmrs.support@gmail.com
EMAIL_FROM_NAME=DMRS

# Gmail SMTP (fallback — chạy tốt ở local, KHÔNG chạy trên Render do bị chặn cổng)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=dmrs.support@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_TIMEOUT=15

# ---- VNPay subscription payments ----
# Register a merchant account and use sandbox credentials during development.
# Set VNPAY_RETURN_URL to the public API return URL in production, and register
# GET https://<public-api>/api/v1/payments/vnpay/ipn as the merchant IPN URL in VNPay.
VNPAY_TMN_CODE=IVIR8WMZ
VNPAY_HASH_SECRET=RCHHTVNBSJFKHGWJABPVNEIAWDDTYTPA
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=127.0.0.1
VNPAY_RETURN_URL=http://localhost:8000/api/v1/payments/vnpay/return
FRONTEND_URL=http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
# Cùng giá trị với GOOGLE_CLIENT_ID ở trên (nhúng lúc build FE)
VITE_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_API_URL=http://localhost:8000
